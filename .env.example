# Roundhouse environment template — copy it, then read this file.
#
#   cp .env.example .env
#
# Every variable below is read by the server at boot (validated with zod) or
# baked into the web build. `docs/self-hosting.md` is the full reference: what
# each one breaks when it is wrong, plus the Compose-only settings (ports,
# database credentials) that live in `.env` but are not read by the app.
#
# The three values a public deployment must change: BETTER_AUTH_SECRET,
# BETTER_AUTH_URL and PUBLIC_WEB_URL.

# --- Required ----------------------------------------------------------------
# Postgres connection string. `db` is the Compose service name; a server running
# on the host uses `localhost`.
DATABASE_URL=postgres://roundhouse:roundhouse@db:5432/roundhouse
# Signs sessions and verification tokens. 32+ characters, random, never reused.
# Changing it signs every player out and voids outstanding verification links.
# Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
BETTER_AUTH_SECRET=change-me-to-a-32+char-secret-value
# The public origin players use. Both must match the address in the browser's
# bar, scheme included: cookies are scoped to it and mail links are built from
# PUBLIC_WEB_URL.
BETTER_AUTH_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:8080

# --- Web build ---------------------------------------------------------------
# Absolute API base baked into the bundle. Leave unset for Compose, where nginx
# proxies /api and /ws on the same origin. Rebuild, not restart, to change it.
# VITE_API_URL=

# --- Server ------------------------------------------------------------------
# Port the API listens on inside its container.
PORT=3001
# debug | info | warn | error. One JSON object per line on stdout. An
# unparseable value falls back to info rather than crashing.
LOG_LEVEL=info
# true when a reverse proxy sets X-Forwarded-For (the bundled nginx overwrites
# it with the real client address). Unset means the socket address is used, so
# every player behind the proxy shares one rate-limit bucket.
# TRUST_PROXY=true

# --- Rate limits -------------------------------------------------------------
# Held in process memory: one container is correct, two replicas double every
# budget. Intents and chat are per player per table; auth is per client address
# per route.
INTENT_RATE_LIMIT=20
INTENT_RATE_WINDOW_MS=10000
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_MS=10000
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# --- Account mail ------------------------------------------------------------
# `log` writes each message to stdout, so no mail server is needed and a reset
# link is readable with `docker compose logs server`. `smtp` sends for real and
# requires MAIL_SMTP_URL — the server refuses to boot with smtp and no URL.
MAIL_TRANSPORT=log
MAIL_FROM=Roundhouse <no-reply@roundhouse.local>
# MAIL_SMTP_URL=smtp://user:pass@smtp.example.com:587
# Refuse sign-in until the address is confirmed, and block creating or joining a
# table until then. Turn it on for anything public: it is what makes password
# recovery prove the address belongs to the player.
# AUTH_REQUIRE_VERIFICATION=true
# Google sign-in appears only when both halves are set; the sign-in page asks the
# server. Redirect URI in the Google console:
# <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
