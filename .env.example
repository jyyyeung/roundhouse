DATABASE_URL=postgres://roundhouse:roundhouse@db:5432/roundhouse
BETTER_AUTH_SECRET=change-me-to-a-32+char-secret-value
# Browser-facing origin (Compose serves auth through nginx on :8080)
BETTER_AUTH_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:8080
# Leave empty in Compose so the web app uses same-origin /api and /ws
# VITE_API_URL=
PORT=3001
# debug | info | warn | error. One JSON object per line on stdout.
LOG_LEVEL=info
# Rate limits. State is per-process memory, so two replicas allow twice the budget.
# Intents: one player, one table. Chat: one player, one table.
INTENT_RATE_LIMIT=20
INTENT_RATE_WINDOW_MS=10000
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_MS=10000
# Sign-in, sign-up and password reset: one client address, one route.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
# true only behind a proxy that sets x-forwarded-for (the Compose web container
# does, and overwrites rather than appends it). Unset trusts the socket address.
# TRUST_PROXY=true
# Account mail. `log` writes each message to stdout (one JSON line), which is the
# default and is how the compose smoke completes a password reset end to end.
# `smtp` needs MAIL_SMTP_URL, e.g. smtp://user:pass@smtp.example.com:587
MAIL_TRANSPORT=log
MAIL_FROM=Roundhouse <no-reply@roundhouse.local>
# MAIL_SMTP_URL=smtp://user:pass@smtp.example.com:587
# Refuse sign-in until the address is confirmed. Off by default so a local stack
# needs no mail server. Turn it on for anything public: it is what makes account
# recovery prove the address belongs to the player.
# AUTH_REQUIRE_VERIFICATION=true
# Google sign-in appears only when both are set; the sign-in page asks the server.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
