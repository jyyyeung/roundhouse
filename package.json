{
  "name": "roundhouse",
  "private": true,
  "scripts": {
    "test": "pnpm -r run test",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:projection": "node scripts/check-projection.mjs",
    "test:integration": "pnpm --filter @roundhouse/server exec vitest run src/room/runtime.integration.test.ts"
  },
  "pnpm": {
    "overrides": {
      "undici": "^8.12.2",
      "source-map-js": "^1.2.2",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
